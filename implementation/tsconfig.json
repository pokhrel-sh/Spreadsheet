{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "sourceMap": true,
    "module": "commonjs",
    "target": "es6",
    "allowJs": true,
    "moduleDetection": "force"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.spec.tsx", "**/*.test.tsx"],
  "exclude": ["node_modules", "**/*.js"]
}
